{
  "Id": "smart-bookmarks-ts",
  "TriggerKeywords": [
    "bm",
    "bookmark"
  ],
  "Name": "Smart Bookmarks (TS)",
  "Description": "Smart Bookmarks plugin for Wox - Supports Edge, Chrome, Brave, Firefox browsers and local bookmarks with multi-profile support",
  "Author": "Kusay Ahmad",
  "Version": "1.0.0",
  "MinWoxVersion": "2.0.0",
  "Runtime": "Nodejs",
  "Website": "https://github.com/KusayAhmad/Wox.Plugin.SmartBookmarks",
  "Entry": "index.js",
  "Icon": "relative:icon.png",
  "SupportedOS": [
    "windows"
  ],
  "SettingDefinitions": [
    {
      "Type": "checkbox",
      "Value": {
        "Key": "enableEdge",
        "Label": "🌐 Enable Edge Browser",
        "Tooltip": "Load bookmarks from Microsoft Edge browser",
        "DefaultValue": "true"
      }
    },
    {
      "Type": "checkbox",
      "Value": {
        "Key": "enableChrome",
        "Label": "   🌐 Enable Chrome Browser",
        "Tooltip": "Load bookmarks from Google Chrome browser",
        "DefaultValue": "true"
      }
    },
    {
      "Type": "newline"
    },
    {
      "Type": "checkbox",
      "Value": {
        "Key": "enableBrave",
        "Label": "🌐 Enable Brave Browser",
        "Tooltip": "Load bookmarks from Brave browser",
        "DefaultValue": "true"
      }
    },
    {
      "Type": "checkbox",
      "Value": {
        "Key": "enableFirefox",
        "Label": "🌐 Enable Firefox Browser",
        "Tooltip": "Load bookmarks from Mozilla Firefox browser",
        "DefaultValue": "true"
      }
    },
    {
      "Type": "newline"
    },
    {
      "Type": "textbox",
      "Value": {
        "Key": "refreshInterval",
        "Label": "⚙️ Refresh Interval (seconds)",
        "Tooltip": "How often to check for bookmark updates (minimum 10 seconds)",
        "DefaultValue": "30"
      }
    },
    {
      "Type": "textbox",
      "Value": {
        "Key": "maxResults",
        "Label": "   ⚙️ Maximum Results",
        "Tooltip": "Maximum number of bookmarks to show in search results",
        "DefaultValue": "20"
      }
    },
    {
      "Type": "newline"
    },
    {
      "Type": "checkbox",
      "Value": {
        "Key": "includeLocalBookmarks",
        "Label": "⚙️ Include Local Bookmarks",
        "Tooltip": "Include bookmarks from the local bookmarks.json file",
        "DefaultValue": "true"
      }
    },
    {
      "Type": "newline"
    },
    {
      "Type": "checkbox",
      "Value": {
        "Key": "showBrowserSource",
        "Label": "🎨 Show Browser Source",
        "Tooltip": "Display which browser each bookmark comes from",
        "DefaultValue": "true"
      }
    },
    {
      "Type": "checkbox",
      "Value": {
        "Key": "showDomain",
        "Label": "   🎨 Show Domain",
        "Tooltip": "Display the website domain in the subtitle",
        "DefaultValue": "true"
      }
    },
    {
      "Type": "newline"
    },
    {
      "Type": "checkbox",
      "Value": {
        "Key": "showDateAdded",
        "Label": "🎨 Show Date Added",
        "Tooltip": "Display when the bookmark was added",
        "DefaultValue": "true"
      }
    },
    {
      "Type": "checkbox",
      "Value": {
        "Key": "showLastUsed",
        "Label": "   🎨 Show Last Used",
        "Tooltip": "Display when the bookmark was last used",
        "DefaultValue": "true"
      }
    },
    {
      "Type": "newline"
    },
    {
      "Type": "checkbox",
      "Value": {
        "Key": "showScore",
        "Label": "🎨 Show Search Score",
        "Tooltip": "Display the relevance score for debugging",
        "DefaultValue": "false"
      }
    },
    {
      "Type": "newline"
    },
    {
      "Type": "table",
      "Value": {
        "Key": "customicons",
        "Title": "Custom Icons",
        "Columns": [
          {
            "Key": "domain",
            "Label": "Domain",
            "Tooltip": "Website domain (e.g., google.com)",
            "Placeholder": "google.com",
            "Width": 200,
            "Type": "text"
          },
          {
            "Key": "iconUrl",
            "Label": "Icon URL",
            "Tooltip": "Direct URL to the favicon/icon",
            "Placeholder": "https://example.com/favicon.ico",
            "Width": 200,
            "Type": "text"
          }
        ]
      }
    }
  ]
}